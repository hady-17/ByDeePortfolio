---
// Picks the best image for a slot, optimised at build time:
//   1. `src`: an image path chosen in the admin area, e.g. /src/assets/uploads/photo.jpg
//   2. a replacement chosen in the admin area for this slot (src/cms/images.json)
//   3. a file named src/assets/<local>.(jpg|jpeg|png|webp|avif)
//   4. a stock photo kept with the site: src/assets/stock/<local>.*
//   5. the stock photo URL in `fallback` (last resort)
import { Image } from 'astro:assets';
import overrides from '../cms/images.json';

const { local, src, fallback, fallbackSrcset, sizes, width, height, alt = '', class: cls, loading, ...rest } = Astro.props;
const mods = import.meta.glob('/src/assets/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', { eager: true }) as Record<string, { default: ImageMetadata }>;
const byPath = (p?: string) => {
  if (!p) return null;
  const want = ('/' + String(p).replace(/^\/+/, '')).toLowerCase();
  const key = Object.keys(mods).find((k) => k.toLowerCase() === want);
  return key ? mods[key].default : null;
};
const byName = (name?: string) => {
  if (!name) return null;
  const key = Object.keys(mods).find((k) => k.toLowerCase().replace(/\.[^.]+$/, '') === `/src/assets/${name}`.toLowerCase());
  return key ? mods[key].default : null;
};
const img = byPath(src) ?? byPath((overrides as Record<string, string>)[local]) ?? byName(local) ?? byName(local && `stock/${local}`);
const w = Number(width);
const eager = loading ?? (rest.fetchpriority === 'high' ? 'eager' : 'lazy');
---
{img ? (
  <Image src={img} width={w} height={Number(height)} widths={[Math.round(w / 2), Math.round(w * 0.75), w]} sizes={sizes ?? `${w}px`} alt={alt} class={cls} loading={eager} {...rest} />
) : fallback ? (
  <img src={fallback} srcset={fallbackSrcset} sizes={sizes} width={width} height={height} alt={alt} class={cls} loading={eager} {...rest} />
) : null}
