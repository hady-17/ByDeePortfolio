---
// Real reviews from src/data/reviews.ts. Renders nothing while the list is empty.
import site from '../../site.config.mjs';
import { reviews } from '../data/reviews';
import { treatments, ui } from '../i18n/treatments';
import { makeT, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const t = makeT(lang);
const u = ui[lang];
const nameOf = (slug: string) => {
  const tr = treatments.find((x) => x.slug === slug);
  return tr ? t(`${tr.key}.title`) : '';
};
---
{reviews.length > 0 && (
  <section class="section reviews" id="reviews" aria-labelledby="reviews-title">
    <div class="container">
      <header class="section__head section__head--center">
        <p class="eyebrow reveal">{t('reviews.eyebrow')}</p>
        <h2 class="h2 reveal" id="reviews-title">{t('reviews.title')}</h2>
      </header>

      <div class="carousel reveal" role="region" aria-roledescription="carousel" aria-label={t('reviews.label')}>
        <div class="carousel__track" aria-live="off">
          {reviews.map((r, i) => (
            <figure class={`carousel__slide${i === 0 ? ' is-active' : ''}`} role="group" aria-roledescription="slide">
              <blockquote><p lang={r.lang} dir={r.lang === 'ar' ? 'rtl' : 'ltr'}>{r.text}</p></blockquote>
              <figcaption><strong>{r.name}</strong>{nameOf(r.treatment) && <> · <span>{nameOf(r.treatment)}</span></>}</figcaption>
            </figure>
          ))}
        </div>
        <div class="carousel__controls">
          <button class="icon-btn icon-btn--line carousel__prev" type="button" aria-label={t('reviews.prev')}><svg class="icon icon--flip" aria-hidden="true"><use href="#i-chev-l"/></svg></button>
          <div class="carousel__dots"></div>
          <button class="icon-btn icon-btn--line carousel__next" type="button" aria-label={t('reviews.next')}><svg class="icon icon--flip" aria-hidden="true"><use href="#i-chev-r"/></svg></button>
        </div>
      </div>
      {site.googleReviewUrl && <p class="reviews__more reveal"><a class="link-arrow" href={site.googleReviewUrl} target="_blank" rel="noopener"><span>{u.reviewsBtn}</span></a></p>}
    </div>
  </section>
)}
