---
// Header + icon sprite for inner pages (treatments, legal). The home page has its own header.
import site from '../../site.config.mjs';
import { makeT, otherLang, localePath, type Lang } from '../i18n';
import { makeP3 } from '../i18n/phase3';

const { lang, path = '/', bookValue } = Astro.props as { lang: Lang; path?: string; bookValue?: string };
const t = makeT(lang);
const q = makeP3(lang);
const home = localePath(lang, '/');
const bookHref = site.bookingUrl || `${home}${bookValue ? `?treatment=${bookValue}` : ''}#booking`;
---
<svg class="sprite" aria-hidden="true" focusable="false">
  <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></symbol>
  <symbol id="i-moon" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
  <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
  <symbol id="i-chat" viewBox="0 0 24 24"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M9 10.5c.5 1.6 2 3.1 3.6 3.6l1.1-1.1 1.8.8-.4 1.6c-3.3.2-7-3.4-6.8-6.8l1.6-.4.8 1.8Z"/></symbol>
</svg>
<a class="skip-link" href="#main">{t('a11y.skip')}</a>
<header class="header is-solid legal-header">
  <div class="container header__bar">
    <a class="logo" href={home}>
      <span class="logo__mark" aria-hidden="true">D</span>
      <span class="logo__text">ByDee<small>{t('logo.sub')}</small></span>
    </a>
    <nav class="subnav" aria-label="Main">
      <a href={`${home}#treatments`}>{t('nav.treatments')}</a>
      <a href={localePath(lang, '/skin-quiz/')}>{q('quiz.nav')}</a>
      <a href={localePath(lang, '/journal/')}>{q('journal.nav')}</a>
      <a href={`${home}#faq`}>{t('nav.faq')}</a>
      <a href={`${home}#contact`}>{t('nav.contact')}</a>
    </nav>
    <div class="header__tools">
      <a class="icon-btn" href={localePath(otherLang(lang), path)} hreflang={otherLang(lang)} lang={otherLang(lang)} aria-label={t('a11y.lang')}>{t('lang.other')}</a>
      <button class="icon-btn js-theme-toggle" type="button" aria-pressed="false">
        <svg class="icon icon--sun" aria-hidden="true"><use href="#i-sun"/></svg>
        <svg class="icon icon--moon" aria-hidden="true"><use href="#i-moon"/></svg>
      </button>
      <a class="btn btn--primary btn--sm header__book" href={bookHref}><span>{t('cta.book')}</span></a>
    </div>
  </div>
</header>
