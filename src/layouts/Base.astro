---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/tajawal/300.css';
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/500.css';
import '@fontsource/tajawal/700.css';
import '../styles/style.css';
import site from '../../site.config.mjs';
import { dirOf, otherLang, localePath, makeT, type Lang } from '../i18n';
import CookieBanner from '../components/CookieBanner.astro';

interface Props { lang: Lang; path?: string; title?: string; description?: string; noindex?: boolean; schema?: boolean; jsonLd?: object[] }
const { lang, path = '/', title, description, noindex = false, schema = false, jsonLd = [] } = Astro.props;
const t = makeT(lang);
const abs = (l: Lang) => new URL(localePath(l, path), site.url).href;
const pageTitle = title ?? t('meta.title');
const pageDesc = description ?? t('meta.desc');
const ogImage = new URL('/og-cover.png', site.url).href;

const sameAs = [site.instagram, site.googleBusinessUrl].filter(Boolean);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: site.name,
  alternateName: ['bydee961', 'By Dee'],
  description: t('meta.desc'),
  url: abs(lang),
  image: new URL('/og-cover.png', site.url).href,
  telephone: site.phone,
  ...(site.email ? { email: site.email } : {}),
  priceRange: '$$',
  inLanguage: ['en', 'ar'],
  address: { '@type': 'PostalAddress', streetAddress: 'Barbir', addressRegion: 'Beirut', addressLocality: 'Beirut', addressCountry: 'LB' },
  ...(site.geo ? { geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng } } : {}),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '16:00' }
  ],
  foundingDate: '2020',
  sameAs
};
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)} class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href={abs(lang)}>
  <link rel="alternate" hreflang="en" href={abs('en')}>
  <link rel="alternate" hreflang="ar" href={abs('ar')}>
  <link rel="alternate" hreflang="x-default" href={abs('en')}>
  <meta name="google-site-verification" content="bY4fZhUD2-Szm9LBUz2UJ5D30kMDoaRPyGBBkZUXIu0">
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}>
  <meta name="theme-color" content="#FAF6EF">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content={abs(lang)}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content={lang === 'ar' ? 'ar_LB' : 'en_US'}>
  <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_LB'}>
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Theme set before first paint (no flash) -->
  <script is:inline>
    (function () {
      var d = document.documentElement, t = null;
      d.className = d.className.replace('no-js', 'js');
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      d.setAttribute('data-theme', t);
    })();
  </script>

  {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
</head>
<body data-ga={site.analytics.ga4Id} data-pixel={site.analytics.metaPixelId}>
  <slot />
  <CookieBanner lang={lang} />
  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
