---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import site from '../../site.config.mjs';
import { makeT, localePath, type Lang } from '../i18n';
import { legalExtra, type LegalDoc } from '../i18n/legal';

const { lang, doc } = Astro.props as { lang: Lang; doc: LegalDoc };
const t = makeT(lang);
const x = legalExtra[lang];
const path = `/${doc.slug}/`;
const date = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-LB' : 'en-GB', { dateStyle: 'long' }).format(new Date(site.lastUpdated));
---
<Base lang={lang} path={path} title={`${doc.title} | ByDee`} description={doc.lead}>
  <SiteHeader lang={lang} path={path} />

  <main id="main" class="legal container">
    <p class="eyebrow">{x.updated}: <time datetime={site.lastUpdated}>{date}</time></p>
    <h1 class="h2">{doc.title}</h1>
    <p class="section__lead">{doc.lead}</p>
    {doc.sections.map((s) => (
      <section>
        <h2 class="legal__h">{s.h}</h2>
        {s.p.map((para) => <p>{para}</p>)}
        {s.ul && <ul>{s.ul.map((li) => <li>{li}</li>)}</ul>}
      </section>
    ))}
    <section>
      <h2 class="legal__h">{x.contact}</h2>
      <p>
        <a href={`tel:${site.phone}`} dir="ltr">{site.phoneDisplay}</a> ·
        <a href={`https://wa.me/${site.whatsapp}`} rel="noopener"> WhatsApp</a>
        {site.email && <> · <a href={`mailto:${site.email}`}>{site.email}</a></>}
      </p>
    </section>
    <p><a class="link-arrow" href={localePath(lang, '/')}>{x.back}</a></p>
  </main>

  <SiteFooter lang={lang} />
</Base>
