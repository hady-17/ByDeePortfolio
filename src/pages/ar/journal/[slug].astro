---
import JournalPost from '../../../layouts/JournalPost.astro';
import { postsFor, slugOf } from '../../../i18n/journal';
export async function getStaticPaths() {
  return (await postsFor('ar')).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props;
---
<JournalPost lang="ar" post={post} />
